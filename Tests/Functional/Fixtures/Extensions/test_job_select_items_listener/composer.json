{
    "name": "tests/test-job-select-items-listener",
    "description": "Extension listening to the select items event of academic_base for the job form of academic_jobs",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Stefan Bürk",
            "email": "stefan@buerk.tech",
            "role": "Maintainer"
        }
    ],
    "require": {
        "typo3/cms-core": "^12.4.22 || ^13.4",
        "fgtclb/academic-jobs": "~2.5.0@dev"
