# Page TSconfig of the job list content element.
#
# Delivered by the set "fgtclb/academic-jobs-list" and registered for the page field
# "Page TSconfig" by "Configuration/TCA/Overrides/pages.php" - one physical
# copy, two ways to it.
#
# The content element is hidden for the whole installation by
# "Configuration/page.tsconfig"; this file is what makes it selectable again,
# so it applies where the component is actually wanted instead of everywhere.
TCEFORM.tt_content.CType.removeItems := removeFromList(academicjobs_list)

mod.wizards.newContentElement.wizardItems.academic {
  elements {
    academicjobs_list {
      iconIdentifier = academic_jobs_icon
      title = LLL:EXT:academic_jobs/Resources/Private/Language/locallang_be.xlf:newContentElement.wizardItems.academic.list.title
      description = LLL:EXT:academic_jobs/Resources/Private/Language/locallang_be.xlf:newContentElement.wizardItems.academic.list.description
      tt_content_defValues {
        CType = academicjobs_list
      }
    }
  }

  # TYPO3 v12 only: the new content element wizard is built from page TSconfig
  # there and every element has to be listed in "show" to be offered at all
  # (NewContentElementController::getWizards()). From v13 on the wizard is built
  # from TCA (Feature: #102834) and the key is ignored, so it stays here as long
  # as this extension supports v12.
  show := addToList(academicjobs_list)
}
