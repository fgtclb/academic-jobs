# The constants of the plugin configuration all content elements of this extension share.
#
# The three content elements are driven by one Extbase plugin namespace,
# "plugin.tx_academicjobs", so there is one physical copy of this block and every
# component folder names it in its own "include_static_file.txt" instead of
# repeating it. The block keeps the folder "Configuration/TypoScript" because
# that is the value stored in every "sys_template" record that selected it so
# far - the component folders are subfolders of it, and each of them reaches it
# through its own "include_static_file.txt".
#
# Every default below is also declared in the "settings.definitions.yaml" of the
# aggregate set, and the two have to stay identical: a site that uses the site
# set and the static template reads this file after the site settings, so a
# default that differs here silently resets what the integrator configured.
plugin.tx_academicjobs {
    view {
        # cat=plugin.tx_academicjobs_createjob/file; type=string; label=Path to template root (FE)
        templateRootPath = EXT:academic_jobs/Resources/Private/Templates/
        # cat=plugin.tx_academicjobs_createjob/file; type=string; label=Path to template partials (FE)
        partialRootPath = EXT:academic_jobs/Resources/Private/Partials/
        # cat=plugin.tx_academicjobs_createjob/file; type=string; label=Path to template layouts (FE)
        layoutRootPath = EXT:academic_jobs/Resources/Private/Layouts/
    }

    persistence {
        # cat=plugin.tx_academicjobs_createjob//a; type=string; label=Default storage PID
        storagePid = 0
    }

    # cat=plugin.tx_academicjobs_createjob//a; type=string; label=Default detail page PID
    detailPid = 0
    # cat=plugin.tx_academicjobs_createjob//a; type=string; label=Default list page PID
    listPid = 0

    email {
        # cat=plugin.tx_academicjobs_createjob//a; type=string; label=Sender email address
        from =
        # cat=plugin.tx_academicjobs_createjob//a; type=string; label=Recipient email address
        recipientEmail =
        # cat=plugin.tx_academicjobs_createjob//a; type=string; label=Email subject
        subject = New job application
        # cat=plugin.tx_academicjobs_createjob//a; type=string; label=Email content
        template = A new job application has been submitted. Please check the backend.
    }

    saveForm {
        # cat=plugin.tx_academicjobs_createjob//a; type=string; label=Default redirect page PID, can be overruled in plugin
        fallbackRedirectPageId = 0
        # cat=plugin.tx_academicjobs_createjob//a; type=options [LLL:EXT:academic_jobs/Resources/Private/Language/locallang.xlf:saveForm.flashMessageCreationMode.option_always=1,LLL:EXT:academic_jobs/Resources/Private/Language/locallang.xlf:saveForm.flashMessageCreationMode.option_suppressWhenRedirectPageIsSelected=0,LLL:EXT:academic_jobs/Resources/Private/Language/locallang.xlf:saveForm.flashMessageCreationMode.option_never=2]; label=LLL:EXT:academic_jobs/Resources/Private/Language/locallang.xlf:saveForm.flashMessageCreationMode.label
        fallbackFlashMessageCreationMode = 0
    }

    jobAvatarImage {
        # cat=plugin.tx_academicjobs//a; type=string; label=An upload folder
        uploadFolder = 1:/global-content/jobs/logos/
        validation {
            fileSize {
                # cat=plugin.tx_academicjobs//a; type=string; label=The maximum file size to accept
                maximum = 2M
            }
            mimeType {
                # cat=plugin.academicjobs//a; type=string; label=Allowed mime types (using */* IANA media types)
                allowedMimeTypes = image/jpeg,image/png,image/webp,image/svg+xml
            }
        }
    }
}
