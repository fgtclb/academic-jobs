# The setup of the plugin configuration all content elements of this extension share.
#
# It belongs to the same folder as "constants.typoscript" next to it: one
# physical copy, named by every component folder's "include_static_file.txt" and
# by the "typoscript" key of no set directly.
page {
  10 {
    templateRootPaths {
      1693651551 = EXT:academic_jobs/Resources/Private/Templates/
    }

    partialRootPaths {
      # The shared partials of EXT:academic_base ("Academic/Image"), which the "Job/Item"
      # partial registered below renders. "page.10" belongs to the site package rather
      # than to this extension, so the key is a negative one of its own: it sorts below
      # every theme and project path, and it is unique across the academic extensions, so
      # it can neither replace one of those paths nor win over an override of
      # "Academic/Image".
      -1758484804 = EXT:academic_base/Resources/Private/Partials/
      1693651551 = EXT:academic_jobs/Resources/Private/Partials/
    }

    layoutRootPaths {
      1693651551 = EXT:academic_jobs/Resources/Private/Layouts/
    }
  }
}

plugin.tx_academicjobs {
  persistence {
    storagePid = {$plugin.tx_academicjobs.persistence.storagePid}
    #recursive = 1
  }
  settings {
    detailPid = {$plugin.tx_academicjobs.detailPid}
    listPid = {$plugin.tx_academicjobs.listPid}

    # The content element layout renders the header of every content element, so the
    # templates render it only for a site whose layout leaves it out. The header partial
    # falls back to the type of the header layout "Default" through the setting below,
    # which plugin settings do not carry the way the settings of `lib.contentElement` do.
    renderContentElementHeader = {$plugin.tx_academicjobs.renderContentElementHeader}
    defaultHeaderType = {$styles.content.defaultHeaderType}

    # The page links of a paginated job list. Pagination itself and the results per
    # page are set on each content element (FlexForm sheet "Pagination").
    pagination {
      numberOfLinks = {$plugin.tx_academicjobs.pagination.numberOfLinks}
    }

    email {
      recipientEmail = {$plugin.tx_academicjobs.email.recipientEmail}
      senderEmail = {$plugin.tx_academicjobs.email.from}
      subject = {$plugin.tx_academicjobs.email.subject}
      template = {$plugin.tx_academicjobs.email.template}
      templateName = {$plugin.tx_academicjobs.email.templateName}
    }

    saveForm {
      fallbackRedirectPageId = {$plugin.tx_academicjobs.saveForm.fallbackRedirectPageId}
      fallbackFlashMessageCreationMode = {$plugin.tx_academicjobs.saveForm.fallbackFlashMessageCreationMode}
    }

    jobAvatarImage {
      uploadFolder = {$plugin.tx_academicjobs.jobAvatarImage.uploadFolder}
      validation {
        fileSize.maximum = {$plugin.tx_academicjobs.jobAvatarImage.validation.fileSize.maximum}
        mimeType.allowedMimeTypes = {$plugin.tx_academicjobs.jobAvatarImage.validation.mimeType.allowedMimeTypes}
      }
    }
  }
  view {
    templateRootPaths {
      10 = EXT:academic_jobs/Resources/Private/Templates/
      20 = {$plugin.tx_academicjobs.view.templateRootPath}
    }
    partialRootPaths {
      # The shared partials of EXT:academic_base ("Academic/Image"). The key sorts below
      # every other one, so a partial of this extension or of the project wins over them.
      -1 = EXT:academic_base/Resources/Private/Partials/
      0 = EXT:fluid_styled_content/Resources/Private/Partials/
      10 = EXT:academic_jobs/Resources/Private/Partials/
      20 = {$plugin.tx_academicjobs.view.partialRootPath}
    }
    layoutRootPaths {
      10 = EXT:academic_jobs/Resources/Private/Layouts/
      20 = {$plugin.tx_academicjobs.view.layoutRootPath}
    }
  }
}

# The job detail sets the title of the job it shows as the title of the page. A page that
# shows no job leaves the provider empty, and the next one decides.
config.pageTitleProviders {
  academicJobs {
    provider = FGTCLB\AcademicJobs\PageTitle\JobTitleProvider
    before = record,seo
  }
}
